# systemd unit for the Mammoth MCP server. Copy it to
# /lib/systemd/system/mammoth_<env>_mcp.service and set the paths and the user.
[Unit]
Description=Mammoth MCP server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mcp
# The settings: see `.env.example`. systemd reads KEY=value lines, no quotes.
EnvironmentFile=/home/ubuntu/mcp/.env
# One process per worker. The server keeps nothing in memory between requests,
# so workers share only the Redis store.
ExecStart=/home/ubuntu/mcp/venv/bin/uvicorn mammoth_mcp_server.app:create_app --factory --host ${MCP_HOST} --port ${MCP_PORT} --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
