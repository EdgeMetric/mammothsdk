# Copy to `.env` beside the service, or set these in the systemd unit.

# This server, as a client reaches it (no trailing slash).
MCP_SERVER_URL=https://mcp.example.com
# The Mammoth web app, for the links a tool gives the user.
MAMMOTH_APP_URL=https://app.example.com
# The host that serves a published dashboard. Defaults to MAMMOTH_APP_URL.
# MAMMOTH_DASHBOARD_URL=https://dashboards.example.com
# The Mammoth API every tool call goes to. Defaults to MAMMOTH_APP_URL + /api/v2.
# MAMMOTH_API_URL=https://app.example.com/api/v2
# The path the API is served under. Set it empty when MAMMOTH_API_URL names an
# API server directly, which serves its routes at their own paths.
# MAMMOTH_API_ROOT=/api/v2

# Mammoth's authorization server, where a client signs the user in. Defaults to
# MAMMOTH_APP_URL + /api/v2. In Mammoth's own settings, name this server's URI,
# MCP_SERVER_URL + /mcp, as a resource a token may be issued for.
# MAMMOTH_OAUTH_URL=https://app.example.com/api/v2

# Where upload tickets are kept.
MCP_REDIS_URL=redis://localhost:6379/0
# Required. The caller's token in an upload ticket is sealed with it. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_ENCRYPTION_KEY=
# Keeps this deployment's records apart from another's in the same Redis.
MCP_STORE_PREFIX=mammoth_mcp

MCP_HOST=127.0.0.1
MCP_PORT=8270
