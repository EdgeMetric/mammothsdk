# Mammoth MCP Server Configuration
# Copy to .env and fill in values.

# ── Server Mode ──────────────────────────────────────────────
# "stdio" for local MCP (Claude Desktop / Claude Code)
# "remote" for deployed OAuth server (Claude UI)
MODE=stdio

# ── MCP Profile ──────────────────────────────────────────────
# Which tool set to load. When using start.sh, this is set per-instance.
# MCP_PROFILE=transformations    # data exploration & transformation (~57 tools)
# MCP_PROFILE=import             # webhooks, connectors, files, batches (~43 tools)
# MCP_PROFILE=admin              # org, dashboards, automations, users (~85 tools)

# ── Remote Mode Settings ─────────────────────────────────────
# Public URL where the server is reachable (used for OAuth redirects)
# SERVER_URL=https://mcp.mammoth.io

# Redis connection (required for remote mode)
# REDIS_URL=redis://localhost:6379/0

# OAuth token lifetimes (seconds)
# AUTH_CODE_TTL=300
# ACCESS_TOKEN_TTL=2592000

# ── CORS (remote mode) ──────────────────────────────────────
# Comma-separated allowed origins (default: claude.ai + console.anthropic.com)
# CORS_ORIGINS=["https://claude.ai","https://console.anthropic.com"]

# ── Rate Limiting (remote mode) ─────────────────────────────
# RATE_LIMIT_RPM=60
# RATE_LIMIT_BURST=10

# ── Credential Encryption (remote mode) ─────────────────────
# Fernet key for encrypting credentials in Redis.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=9000
LOG_LEVEL=INFO
# LOG_FORMAT=text
# LOG_FILE=/var/log/mammoth-mcp/server.log

# ── Multi-Profile Ports (used by start.sh) ───────────────────
# When running all 3 profiles via start.sh, each gets its own port.
# Defaults: transformations=PORT, import=PORT+1, admin=PORT+2
# TRANSFORMATIONS_PORT=9000
# IMPORT_PORT=9001
# ADMIN_PORT=9002

# ── Mammoth API Defaults ─────────────────────────────────────
# Base URL for the Mammoth API
# MAMMOTH_BASE_URL=https://app.mammoth.io/api/v2

# Job timeout in seconds
# MAMMOTH_JOB_TIMEOUT=120

# ── Stdio Mode Only ─────────────────────────────────────────
# Required when MODE=stdio (ignored in remote mode)
# MAMMOTH_API_KEY=
# MAMMOTH_API_SECRET=
# MAMMOTH_WORKSPACE_ID=
# MAMMOTH_PROJECT_ID=
